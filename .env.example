# Configuration Botora Admin — développement uniquement
# auto détecte les hôtes locaux pour le local et tout domaine public pour le serveur.
DB_MODE=auto
DB_AUTO_MIGRATE=true
DB_LOCAL_HOST=localhost
DB_LOCAL_PORT=3306
DB_LOCAL_NAME=botora_admin
DB_LOCAL_USER=root
DB_LOCAL_PASS=
APP_URL=http://localhost
BOTORA_API_URL=http://localhost
BOTORA_ADMIN_EMAIL=admin@botora.local
BOTORA_ADMIN_PASSWORD=BotoraAdmin#2026
APP_DEBUG=true

# FedaPay : renseigner uniquement dans l'environnement local réel.
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_WEBHOOK_SECRET=
