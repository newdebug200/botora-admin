# Configuration Botora Admin — développement uniquement
# auto détecte les hôtes locaux pour le local et tout domaine public pour le serveur.
DB_MODE=auto
DB_AUTO_MIGRATE=true
DB_LOCAL_HOST=localhost
DB_LOCAL_PORT=3306
DB_LOCAL_NAME=botora_admin
DB_LOCAL_USER=root
DB_LOCAL_PASS=
# Production: set DB_MODE=online and define the following in the server's
# private .env file. Never commit production credentials.
# DB_ONLINE_HOST=
# DB_ONLINE_PORT=3306
# DB_ONLINE_NAME=
# DB_ONLINE_USER=
# DB_ONLINE_PASS=
APP_URL=http://localhost:8000
BOTORA_API_URL=http://localhost:8000
BOTORA_ADMIN_EMAIL=admin@botora.local
BOTORA_ADMIN_PASSWORD=BotoraAdmin#2026
APP_DEBUG=true
# Clé de développement locale ; en production, choisir une clé forte et
# configurer la même valeur dans BOTORA_ADMIN_SERVICE_KEY côté backend.
BOTORA_SERVICE_KEY=abcd

# FedaPay : renseigner uniquement dans l'environnement local réel.
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_WEBHOOK_SECRET=
